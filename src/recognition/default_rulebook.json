  "rules": [
    {
      "id": "rest_rule_1",
      "activity": "Rest/Sleeping",
      "weight": 0.8,
      "when_all": [
        {
          "field": "dominant_room_type",
          "op": "in",
          "value": [
            "bedroom",
            "living"
          ]
        }
      ],
      "when_any": [
        {
          "field": "hour",
          "op": "in",
          "value": [
            22,
            23,
            0,
            1,
            2,
            3,
            4,
            5
          ]
        },
        {
          "field": "duration_s",
          "op": ">=",
          "value": 1800
        },
        {
          "field": "Active_ratio",
          "op": "<=",
          "value": 0.2
        }
      ],
      "evidence_template": "Rest-like room with at least one supporting rest cue."
    },
    {
      "id": "rest_rule_2",
      "activity": "Rest/Sleeping",
      "weight": 0.7,
      "when_all": [
        {
          "field": "dominant_room_type",
          "op": "==",
          "value": "bedroom"
        }
      ],
      "when_any": [
        {
          "field": "duration_s",
          "op": ">=",
          "value": 600
        },
        {
          "field": "Salience_mean",
          "op": "<=",
          "value": 5.0
        }
      ],
      "evidence_template": "Bedroom episode with moderate duration or low activity."
